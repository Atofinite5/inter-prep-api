# ============================================================
# AI Interview Prep Kit — ENV LAUNCHER
# Copy to .env:  cp .env.example .env
# Then paste your keys where marked PASTE_*.
# ============================================================

# ---------- Server ----------
PORT=5001
NODE_ENV=development
# Frontend URL (for CORS / links in emails). Change in production.
CLIENT_URL=http://localhost:3000

# ---------- LLM provider switch ----------
# auto = use OpenRouter if OPENROUTER_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else heuristic fallback.
# Force one with: openrouter | gemini
LLM_PROVIDER=auto

# ---------- OpenRouter (RECOMMENDED — one key, many models) ----------
# Get key: https://openrouter.ai/keys
# NOTE: There is NO model called "gemini-3.8-flash". Use one of these:
#   google/gemini-2.5-flash  (current, recommended)
#   google/gemini-2.0-flash  (fast, cheap)
#   anthropic/claude-3.5-sonnet | openai/gpt-4o-mini  (alternatives)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional (for OpenRouter rankings / debugging):
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI-Interview-Prep-Kit

# ---------- Direct Google Gemini (optional fallback) ----------
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---------- Database (MongoDB Atlas) ----------
# Local dev:  mongodb://localhost:27017/interview_prep_db
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview_prep_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/interview_prep_db

# ---------- Auth ----------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_session_jwt_key_change_in_production
SESSION_EXPIRY=7d

# ---------- Crawler / SSRF ----------
# Keep true for local dev + batch eval with localhost URLs. Set false in production.
ALLOW_LOCAL_HOSTS=true
CRAWLER_MAX_PAGES=4
CRAWLER_TIMEOUT_MS=8000
CRAWLER_USER_AGENT=AI-Interview-Prep-Bot/1.0

# ---------- Frontend (client/.env.local) ----------
# NEXT_PUBLIC_API_URL=http://localhost:5001/api
